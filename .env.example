# ==============================================================================
# ProcurePulse AI - Autonomous Procurement & Supply Chain Agent Platform Config
# ==============================================================================

# Application Settings
APP_NAME=ProcurePulse AI
APP_ENV=development
DEBUG=True
PORT=8000
HOST=0.0.0.0

# Database Configuration (SQLite default for zero-config local run, or PostgreSQL)
DATABASE_URL=sqlite:///./procurepulse.db
# For PostgreSQL with pgvector:
# DATABASE_URL=postgresql+psycopg2://procure_user:procure_pass@localhost:5432/procurepulse

# LLM Provider Configuration
# Options: "mock" (built-in autonomous engine), "openai", "anthropic", "gemini"
LLM_PROVIDER=mock
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Guardrail & Policy Thresholds
MAX_AUTO_APPROVE_AMOUNT=5000.00
MANAGER_APPROVAL_THRESHOLD=25000.00
MAX_PRICE_VARIANCE_PERCENT=5.0
SAFETY_STOCK_BUFFER_DAYS=14
DEFAULT_CURRENCY=USD

# RAG & Vector Store Configuration
VECTOR_STORE_TYPE=hybrid-memory
EMBEDDING_MODEL=text-embedding-3-small
TOP_K_RETRIEVAL=4
SIMILARITY_THRESHOLD=0.65

# Human-In-The-Loop (HITL) Settings
HITL_AUTO_RESUME_ON_APPROVAL=True
ESCALATION_EMAIL_NOTIFICATIONS=True
COMPLIANCE_ENFORCEMENT_STRICT=True
